{
  "schemaVersion": 1,
  "id": "${id}",
  "version": "${version}",
  "name": "${name}",
  "description": "${description}",
  "authors": [
    "${authors}"
  ],
  "contributors": [
    "unroman"
  ],
  "contact": {
    "homepage": "https://github.com/maulve/maulves-scythes",
    "sources": "https://modrinth.com/mod/maulves-scythes"
  },
  "license": "${license}",
  "icon": "assets/${id}/icon-big.png",
  "environment": "*",
  "entrypoints": {
    "main": [
      "${main_package}.MaulvesScythes::onInitialize"
    ],
    "client": [
      "${main_package}.MaulvesScythes::onInitializeClient"
    ]
  },
  "mixins": [
    "${id}.mixins.json"
  ],
  "depends": {
    "fabricloader": ">=0.15.0",
    "minecraft": "${minecraft_range}",
    "java": ">=${java_version}",
    "fabric-api": "*"
  }
}
